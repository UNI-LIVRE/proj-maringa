# Copie este arquivo para ".env" e ajuste se precisar.
# O arquivo .env NÃO vai para o GitHub (está no .gitignore).

# Endereço do MongoDB.
#   Local:  mongodb://127.0.0.1:27017
#   Nuvem (Atlas, no futuro): mongodb+srv://usuario:senha@cluster.xxxxx.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017

# Nome do banco de dados
MONGODB_DB=campo_iam

# Porta (abra http://localhost:PORTA)
PORT=3000

# Quem pode acessar a porta diretamente. 127.0.0.1 = só este computador.
# Deixe assim também na nuvem: lá o Caddy recebe o HTTPS e repassa para cá.
HOST=127.0.0.1

# Quantos dias a pessoa fica logada antes de precisar entrar de novo
SESSAO_DIAS=7

# Em produção (na nuvem, com HTTPS) descomente a linha abaixo.
# Ela liga o cookie seguro, o HSTS e o reconhecimento do IP real atrás do balanceador.
# NODE_ENV=production

# Como um usuário novo recebe o acesso:
#   senha → o administrador vê uma senha provisória na tela e a repassa
#   email → convite por e-mail (disponível quando o envio de e-mail for configurado)
CONVITE_MODO=senha
