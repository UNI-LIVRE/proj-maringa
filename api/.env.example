# Copie este arquivo para ".env" e ajuste se precisar.
# O arquivo .env NÃO vai para o GitHub (está no .gitignore).

# Endereço do MongoDB.
#   Local:  mongodb://127.0.0.1:27017
#   Nuvem (Atlas, no futuro): mongodb+srv://usuario:senha@cluster.xxxxx.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017

# Nome do banco de dados
MONGODB_DB=campo_iam

# Porta da API
PORT=3000

# Sites autorizados a usar a API, separados por vírgula.
# Vazio = aceita apenas localhost / 127.0.0.1 (desenvolvimento).
# Em produção, coloque o endereço do site, ex.: https://usuario.github.io
CORS_ORIGINS=
