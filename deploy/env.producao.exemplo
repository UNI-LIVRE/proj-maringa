# ═══════════════════════════════════════════════════════════════
#  Modelo do api/.env NO SERVIDOR (produção).
#  NÃO coloque a senha neste arquivo modelo nem no GitHub.
#  No servidor, o arquivo real fica em /opt/unilivre/app/api/.env
#  (dono: campo, permissão 600) e a senha é digitada direto nele.
# ═══════════════════════════════════════════════════════════════

# Endereço do Atlas: copie em Atlas → Database → Connect → Drivers.
# Troque <SENHA> pela senha do usuário campo-iam-api (do gerenciador de senhas).
# Se a senha tiver símbolos como @ : / ? # %, gere outra só com letras e números
# (o Atlas tem o botão "Autogenerate Secure Password").
MONGODB_URI=mongodb+srv://campo-iam-api:<SENHA>@<ENDERECO-DO-CLUSTER>.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB=campo_iam
PORT=3000

# só o próprio servidor acessa a porta 3000; quem atende de fora é o Caddy (HTTPS)
HOST=127.0.0.1

SESSAO_DIAS=7

# produção: cookie só por HTTPS, HSTS e IP real de quem acessa (atrás do Caddy)
NODE_ENV=production

CONVITE_MODO=senha
